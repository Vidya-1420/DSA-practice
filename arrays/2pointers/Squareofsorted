class Solution {
    public int[] sortedSquares(int[] nums) {
        int res[]=new int[nums.length];
        int left=0;
        int right=nums.length-1;
        int pos = nums.length-1;

        while(left <= right){
          int s1 =nums[left] * nums[left];
          int s2 =nums[right] * nums[right];
        
        if(s1 > s2){
            res[pos]=s1;
            left++;
        }
        else {
            res[pos]=s2;
            right--;
         }
        pos--;
    }
    return res;
}
}
